      "targets": [
        { "expr": "shim_failover_primary_check_ms", "legendFormat": "primary", "refId": "A" },
        { "expr": "shim_failover_replica_check_ms", "legendFormat": "replica", "refId": "B" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 104,
      "title": "Config Reload",
