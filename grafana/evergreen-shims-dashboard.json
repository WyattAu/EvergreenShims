      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Per-Tenant Event Rate",
      "type": "timeseries",
      "targets": [{ "expr": "rate(shim_tenant_events_total[5m])", "legendFormat": "{{tenant_id}}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "id": 51,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Per-Tenant Rejections",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(shim_tenant_rate_limited_total[5m])", "legendFormat": "{{tenant_id}} rate-limited", "refId": "A" },
        { "expr": "rate(shim_tenant_memory_exceeded_total[5m])", "legendFormat": "{{tenant_id}} memory-exceeded", "refId": "B" }
      ]
