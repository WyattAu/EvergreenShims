# =============================================================================
# Multi-arch health-shim scratch image
# Contains only the statically-linked musl binary
# Used as COPY source in EvergreenImageRegistry Dockerfiles
# Built with docker buildx for multi-arch support
# =============================================================================
FROM rust:1-alpine AS builder

ARG TARGETARCH

# Install target-specific tools
RUN apk add --no-cache musl-dev gcc

# Add cross-compilation support for arm64
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      apk add --no-cache gcc-aarch64-none-elf; \
    fi

WORKDIR /src
COPY . .

# Determine target triple
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      export TARGET="aarch64-unknown-linux-musl"; \
      rustup target add "$TARGET"; \
      cargo build --release -p evergreen-shim --no-default-features --features health --target "$TARGET" && \
      cp target/"$TARGET"/release/shim /shim; \
    else \
      cargo build --release -p evergreen-shim --no-default-features --features health --target x86_64-unknown-linux-musl && \
      cp target/x86_64-unknown-linux-musl/release/shim /shim; \
    fi

FROM scratch
COPY --from=builder /shim /shim
USER 65532:65532
LABEL org.opencontainers.image.title="health-shim" \
      org.opencontainers.image.description="EvergreenShims health probe binary - statically linked musl" \
      org.opencontainers.image.vendor="WyattAu" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenShims"
