# =============================================================================
# Multi-arch shim scratch image
# Contains only the statically-linked musl binary (stripped)
# Used as COPY source in EvergreenImageRegistry Dockerfiles
# Built with docker buildx for multi-arch support
#
# Build health-only (default, smallest):
#   docker buildx build --target shim-health .
#
# Build full (all 27 shims):
#   docker buildx build --build-arg FEATURES=full --target shim-full .
# =============================================================================
# Pin to Rust 1.87 for reproducible builds.
# MSRV: aws-config@1.8.18 requires rustc >= 1.91.1, so this Docker image must be >= 1.91.
FROM rust:1.91-alpine3.21 AS chef
RUN cargo install cargo-chef --locked
WORKDIR /src

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

ARG TARGETARCH
ARG FEATURES=health

# Install target-specific tools + strip
RUN apk add --no-cache musl-dev gcc
RUN if [ "$TARGETARCH" = "arm64" ]; then \
      apk add --no-cache gcc-aarch64-none-elf; \
    fi
RUN if [ "$TARGETARCH" = "riscv64" ]; then \
      apk add --no-cache gcc-riscv64-unknown-elf; \
    fi

WORKDIR /src
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --release -p evergreen-shim --no-default-features --features "$FEATURES" --recipe-path recipe.json
COPY . .

# Determine target triple (with retry for transient network errors)
RUN --mount=type=cache,target=/src/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    for attempt in 1 2 3; do \
      if [ "$TARGETARCH" = "arm64" ]; then \
        export TARGET="aarch64-unknown-linux-musl"; \
        rustup target add "$TARGET"; \
        cargo build --release -p evergreen-shim --no-default-features --features "$FEATURES" --target "$TARGET" && \
        strip target/"$TARGET"/release/shim && \
        cp target/"$TARGET"/release/shim /shim && break; \
      elif [ "$TARGETARCH" = "riscv64" ]; then \
        export TARGET="riscv64gc-unknown-linux-musl"; \
        rustup target add "$TARGET"; \
        cargo build --release -p evergreen-shim --no-default-features --features "$FEATURES" --target "$TARGET" && \
        strip target/"$TARGET"/release/shim && \
        cp target/"$TARGET"/release/shim /shim && break; \
      else \
        cargo build --release -p evergreen-shim --no-default-features --features "$FEATURES" --target x86_64-unknown-linux-musl && \
        strip target/x86_64-unknown-linux-musl/release/shim && \
        cp target/x86_64-unknown-linux-musl/release/shim /shim && break; \
      fi; \
      echo "Attempt $attempt failed, retrying in 30s..."; \
      sleep 30; \
    done

FROM scratch AS shim-health
COPY --from=builder /shim /shim
USER 65532:65532
LABEL org.opencontainers.image.title="health-shim" \
      org.opencontainers.image.description="EvergreenShims health probe binary - statically linked musl" \
      org.opencontainers.image.vendor="WyattAu" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenShims" \
      org.opencontainers.image.version="1.3.0" \
      org.opencontainers.image.licenses="Apache-2.0"

FROM scratch AS shim-full
COPY --from=builder /shim /shim
USER 65532:65532
LABEL org.opencontainers.image.title="evergreen-shim" \
      org.opencontainers.image.description="EvergreenShims full binary (all 27 shims) - statically linked musl" \
      org.opencontainers.image.vendor="WyattAu" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenShims" \
      org.opencontainers.image.version="1.3.0" \
      org.opencontainers.image.licenses="Apache-2.0"

FROM scratch AS shim-db
COPY --from=builder /shim /shim
USER 65532:65532
LABEL org.opencontainers.image.title="db-shim" \
      org.opencontainers.image.description="EvergreenShims DB binary (health+vault+backup+migration+audit) - statically linked musl" \
      org.opencontainers.image.vendor="WyattAu" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenShims" \
      org.opencontainers.image.version="1.3.0" \
      org.opencontainers.image.licenses="Apache-2.0"

FROM scratch AS shim-cache
COPY --from=builder /shim /shim
USER 65532:65532
LABEL org.opencontainers.image.title="cache-shim" \
      org.opencontainers.image.description="EvergreenShims cache binary (health+cache) - statically linked musl" \
      org.opencontainers.image.vendor="WyattAu" \
      org.opencontainers.image.source="https://github.com/WyattAu/EvergreenShims" \
      org.opencontainers.image.version="1.3.0" \
      org.opencontainers.image.licenses="Apache-2.0"
