#!/usr/bin/env bash
# Pre-commit hook for EvergreenShims
# Enforces: formatting, clippy, unit tests, secret scanning, dead code.
#
# Install: git config core.hooksPath .githooks
# Or run: ./scripts/install-hooks.sh

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

step() { echo -e "${YELLOW}>>> $1${NC}"; }
pass() { echo -e "${GREEN}PASS: $1${NC}"; }
fail() { echo -e "${RED}FAIL: $1${NC}"; exit 1; }

START_TIME=$(date +%s)

# Stage all modified files so fmt/clippy see the actual code
git diff --cached --name-only --diff-filter=ACM -- '*.rs' '*.toml' | head -1 > /dev/null 2>&1 || true

# Step 1: Formatting
step "Checking formatting (cargo fmt)..."
if ! cargo fmt --all -- --check 2>/dev/null; then
    echo "Auto-formatting staged files..."
    cargo fmt --all
    # Re-stage formatted files
    git diff --cached --name-only --diff-filter=ACM -- '*.rs' | while read -r f; do
        git add "$f" 2>/dev/null || true
    done
    pass "Formatting applied and re-staged"
else
    pass "Formatting"
fi

# Step 2: Clippy lint
step "Running clippy..."
if ! cargo clippy --workspace --all-targets -- -D warnings 2>/dev/null; then
    fail "Clippy failed. Fix warnings before committing."
fi
pass "Clippy"

# Step 3: Unit tests (skip integration tests for speed -- they run in CI)
step "Running unit tests..."
if ! cargo test --workspace --lib -- --quiet 2>/dev/null; then
    fail "Unit tests failed."
fi
pass "Unit tests"

# Step 4: Secret scanning (hardcoded credentials in staged files)
step "Scanning for hardcoded secrets..."
# Only scan config/env files for credential patterns (Rust source files have field names, not values)
CONFIG_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.toml' '*.yml' '*.yaml' '*.env' '*.env.*' '*.cfg' '*.ini' 2>/dev/null || true)
SECRET_PATTERNS=(
    'password\s*=\s*"[^"]{8,}"'
    'secret\s*=\s*"[^"]{8,}"'
    'api_key\s*=\s*"[^"]{8,}"'
    'token\s*=\s*"[^"]{8,}"'
)
SECRET_FOUND=false
for pattern in "${SECRET_PATTERNS[@]}"; do
    if echo "$CONFIG_FILES" | xargs grep -lE "$pattern" 2>/dev/null | head -1 > /dev/null 2>&1; then
        echo -e "${RED}Potential secret found matching: ${pattern}${NC}"
        SECRET_FOUND=true
    fi
done
# Check for private keys in config/env files (not Rust source which may generate keys in tests)
CONFIG_KEY_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.toml' '*.yml' '*.yaml' '*.env' '*.env.*' '*.pem' '*.key' 2>/dev/null || true)
if echo "$CONFIG_KEY_FILES" | xargs grep -l 'BEGIN.*PRIVATE KEY' 2>/dev/null | head -1 > /dev/null 2>&1; then
    echo -e "${RED}Private key detected in staged files${NC}"
    SECRET_FOUND=true
fi
if [ "$SECRET_FOUND" = true ]; then
    fail "Hardcoded secrets detected. Use environment variables or a secrets manager."
fi
pass "Secret scanning"

# Step 5: Check for accidental unwrap() in library code
step "Checking for unwrap()/expect() in library code..."
UNWRAP_FOUND=false
for f in $(git diff --cached --name-only --diff-filter=ACM -- '*.rs' 2>/dev/null); do
    # Skip test files, benchmarks, and main.rs (binary entry points)
    if echo "$f" | grep -qE '(tests/|test_|benches/|main\.rs)'; then
        continue
    fi
    if grep -nE '\.(unwrap|expect)\(' "$f" 2>/dev/null | grep -v '#\[cfg(test)\]' | grep -v '//.*unwrap' | grep -v '//.*expect' | head -1 > /dev/null 2>&1; then
        echo -e "${YELLOW}Warning: unwrap()/expect() found in $f${NC}"
        grep -nE '\.(unwrap|expect)\(' "$f" 2>/dev/null | grep -v '#\[cfg(test)\]' | grep -v '//.*unwrap' | grep -v '//.*expect' | head -5
        UNWRAP_FOUND=true
    fi
done
if [ "$UNWRAP_FOUND" = true ]; then
    echo -e "${YELLOW}unwrap()/expect() detected in library code. Prefer ? operator or context(). Continuing...${NC}"
fi
pass "unwrap()/expect() check"

# Step 6: Check for crate-level #![allow(dead_code)]
step "Checking for crate-level dead_code suppression..."
DEADCODE_FOUND=false
for f in $(git diff --cached --name-only --diff-filter=ACM -- '*.rs' 2>/dev/null); do
    if head -5 "$f" 2>/dev/null | grep -q '#!\[allow(dead_code)\]'; then
        echo -e "${RED}Crate-level #![allow(dead_code)] found in $f${NC}"
        echo -e "${RED}Use targeted #[allow(dead_code)] on specific items instead${NC}"
        DEADCODE_FOUND=true
    fi
done
if [ "$DEADCODE_FOUND" = true ]; then
    fail "Crate-level #![allow(dead_code)] is not allowed. Use targeted annotations."
fi
pass "dead_code check"

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))
echo -e "${GREEN}All pre-commit checks passed in ${DURATION}s.${NC}"
