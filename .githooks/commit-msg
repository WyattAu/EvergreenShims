#!/usr/bin/env bash
# Commit-msg hook for EvergreenShims
# Enforces Conventional Commits format.
#
# Format: type(scope): description
# Types:   feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
# Scope:   optional, lowercase alphanumeric + hyphens
# Subject: imperative mood, lowercase first letter, no period, <= 72 chars

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits
if echo "$COMMIT_MSG" | head -1 | grep -qE '^Merge '; then
    exit 0
fi

# Skip fixup/squash/amend commits
if echo "$COMMIT_MSG" | head -1 | grep -qE '^(fixup|squash|amend)!'; then
    exit 0
fi

# Validate first line against Conventional Commits regex
FIRST_LINE=$(echo "$COMMIT_MSG" | head -1)
TYPE_REGEX='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)'

if ! echo "$FIRST_LINE" | grep -qE "$TYPE_REGEX"; then
    echo -e "${RED}ERROR: Commit message does not follow Conventional Commits format.${NC}"
    echo ""
    echo "Expected format: type(scope): description"
    echo "Allowed types:   feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo "Example:         fix(backup-shim): handle empty S3 bucket"
    echo ""
    echo "Got: $FIRST_LINE"
    exit 1
fi

# Check subject line length (first line)
FIRST_LINE_LEN=${#FIRST_LINE}
if [ "$FIRST_LINE_LEN" -gt 72 ]; then
    echo -e "${RED}ERROR: Subject line too long ($FIRST_LINE_LEN > 72 chars).${NC}"
    echo "Got: $FIRST_LINE"
    exit 1
fi

# Ensure subject starts with lowercase (after type/scope prefix)
SUBJECT_TEXT=$(echo "$FIRST_LINE" | sed -E 's/^[a-z]+(\([^)]+\))?: //')
FIRST_CHAR=$(echo "$SUBJECT_TEXT" | head -c1)
if echo "$FIRST_CHAR" | grep -qE '[A-Z]'; then
    echo -e "${RED}ERROR: Subject line should start with lowercase letter.${NC}"
    echo "Got: $FIRST_LINE"
    exit 1
fi

# Ensure subject does not end with period
if echo "$FIRST_LINE" | grep -qE '\.$'; then
    echo -e "${RED}ERROR: Subject line should not end with a period.${NC}"
    echo "Got: $FIRST_LINE"
    exit 1
fi

echo -e "${GREEN}PASS: Commit message valid.${NC}"
