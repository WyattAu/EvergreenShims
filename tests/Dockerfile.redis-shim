# =============================================================================
# TEST: Redis with health-shim as PID 1
# Uses locally-built musl binary
# =============================================================================
FROM redis:7-alpine

# Copy pre-built musl health-shim binary from host build
COPY target/x86_64-unknown-linux-musl/release/shim /usr/local/bin/shim
RUN chmod +x /usr/local/bin/shim

EXPOSE 6379 9101

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/shim"]
CMD ["--debug", "-c", "redis-server", "--", "--bind", "0.0.0.0", "--protected-mode", "no"]
