# =============================================================================
# TEST: Redis with health-shim as PID 1
# Uses locally-built musl binary
# =============================================================================
FROM redis:7-alpine

# Copy pre-built musl health-shim binary from host build
COPY target/x86_64-unknown-linux-musl/release/shim /usr/local/bin/shim
RUN chmod +x /usr/local/bin/shim

EXPOSE 6379 9101

# Health check via shim binary (TCP to redis)
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:6379"]

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/shim", "run", "--debug"]
CMD ["-c", "redis-server", "--", "--bind", "0.0.0.0", "--protected-mode", "no"]
