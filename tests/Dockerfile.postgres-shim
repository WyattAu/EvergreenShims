# =============================================================================
# TEST: Postgres with health-shim as PID 1
# Uses locally-built musl binary
# =============================================================================
FROM postgres:17-alpine

# Copy pre-built musl health-shim binary from host build
COPY target/x86_64-unknown-linux-musl/release/shim /usr/local/bin/shim
RUN chmod +x /usr/local/bin/shim

EXPOSE 5432 9101

# Health check via shim binary (TCP to postgres)
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
  CMD ["/usr/local/bin/shim", "healthcheck", "--tcp", "127.0.0.1:5432"]

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/shim", "run", "--debug"]
CMD ["-c", "docker-entrypoint.sh", "--", "postgres"]
